# Copia este archivo como .env (y .env.local) y ajusta los valores.

# Dónde está el archivo de SQLite (relativo a prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Clave de la API de Anthropic para elegir el match con IA (va en .env.local).
# Si la dejas vacía, la app usa el método básico por palabras clave.
ANTHROPIC_API_KEY=

# Clave para entrar al panel de la presentadora (#panel). Sin ella nadie entra.
# Ponla también en las Variables de Railway.
CLAVE_PRESENTADORA=

# Dirección a la que lleva el QR. Si la dejas vacía, usa la dirección desde donde abres la app.
# NEXT_PUBLIC_SHARE_URL=https://match-networkeando-production.up.railway.app
