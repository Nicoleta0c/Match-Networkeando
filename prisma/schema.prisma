// Base de datos SQLite: un solo archivo (prisma/dev.db) en la carpeta del proyecto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Un perfil por persona. El id es el id anónimo que guarda la cookie.
// Mismos campos que limpiar() en el original. SQLite no tiene listas,
// así que needs y likes se guardan como texto JSON.
model Perfil {
  id        String   @id
  idea      String   @default("")
  needs     String   @default("[]")
  power     String
  anon      Boolean  @default(true)
  alias     String   @default("")
  que       String   @default("")
  contact   String   @default("")
  likes     String   @default("[]")
  color     String   @default("")
  createdAt Float
  updatedAt DateTime @updatedAt
  // En qué evento se registró. Sirve para los dos niveles del Mapa de Sueños:
  // todos los eventos juntos y cada evento por separado. Vacío = pruebas de antes.
  evento    String   @default("")

  @@index([createdAt])
  @@index([evento])
}

// Chat temporal entre matches: para ponerse de acuerdo y encontrarse en el evento.
// Los mensajes se borran solos a las 12 horas.
model Mensaje {
  id     Int    @id @default(autoincrement())
  de     String
  para   String
  texto  String
  creado Float

  @@index([de])
  @@index([para])
  @@index([creado])
}

// Si alguien te molesta, lo bloqueas: ya no puede escribirte ni ver tu chat.
model Bloqueo {
  de   String
  para String

  @@id([de, para])
}
